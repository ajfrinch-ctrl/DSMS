  // Extract digits only for each account segment or preserve existing structure if typed carefully\n            let digitsOnly = trimmed.replace(/\\D/g, '');\n            if(digitsOnly.length > 6) {\n                // Keep first 3-4 digits and last 3-4 digits, replace middle zeros/digits with hyphen\n                let midStart = Math.min(3, Math.floor(digitsOnly.length / 3));\n                let midEnd = Math.max(digitsOnly.length - 3, Math.floor(digitsOnly.length * 2 / 3));\n                let startPart = digitsOnly.slice(0, midStart);\n                let endPart = digitsOnly.slice(midEnd);\n                if(startPart && endPart && startPart !== endPart) {\n                    return startPart + '-' + endPart;\n                }\n            }\n            // Fallback general replacement of consecutive zeros in middle\n            return digitsOnly.replace(/(\\d)0+(\\d)/g, '$1-$2');\n        });\n        \n        let formatted = formattedParts.join(', ');\n        if(formatted !== raw) {\n            let start = this.selectionStart;\n            this.value = formatted;\n            this.setSelectionRange(start, start);\n        }\n    });\n}\n\nsetupAccountInputFormatting(document.getElementById('acct'));\n\nconst wk=s=>{\n    let d=new Date(s+'T00:00:00');\n    let day=d.getDay();\n    let diff=(day===6)?0:-(day+1);\n    d.setDate(d.getDate()+diff);\n    return iso(d);\n};\n\nfunction persist(){localStorage.setItem(KEY,JSON.stringify(entries));}\n\nfunction tab(id,b){\n    document.querySelectorAll('.pane').forEach(x=>x.classList.remove('active'));\n    document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));\n    document.getElementById(id).classList.add('active');\n    b.classList.add('active');\n    if(id==='report') { populateReportWeeks(); generateReport(); }\n    if(id==='storage') { populateLogWeeks(); renderWeeklyLog(); renderAllLog(); }\n}\n\nfunction subTab(id,b){\n    document.querySelectorAll('.sub-pane').forEach(x=>x.class