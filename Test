nk PLC\u003cbr>Monthly Deposit Mobilization Sheet\u003cbr>Individual Deposit Target Achievement Report\u003cbr>Month Name : July - ${monthName}, ${mYear}`;\n    }\n    \n    let gTarget = 0, gNewCount = 0, gPeriodNew = 0, gPeriodEx = 0, gPeriodTotal = 0, gCumulative = 0;\n\n    MASTER.forEach((x,i)=>{\n        let sumNew = 0, sumEx = 0;\n        let baseAs = x.accounts.split(',').map(s=>s.trim()).filter(Boolean);\n        let seenAs = new Set(baseAs);\n        let allNewAccts = [...baseAs];\n        let cumTotal = x.baseCumulative;\n        let currentPeriodNewAccts = new Set();\n        let pastPeriodAccts = new Set();\n\n        if(isWeekly){\n            let pastEntries = entries.filter(e => e.empIdx === i && e.date \u003c targetWk);\n            pastEntries.forEach(e => {\n                (e.accounts||[]).forEach(acc => { if(acc) pastPeriodAccts.add(acc); });\n            });\n\n            let weekEntries = entries.filter(e => e.empIdx === i && e.date >= targetWk && e.date \u003c= endWk);\n            weekEntries.forEach(e=>{\n                sumNew += n(e.newA);\n                sumEx += n(e.exA);\n                (e.accounts||[]).forEach(acc => { if(acc) currentPeriodNewAccts.add(acc); });\n            });\n\n            let upToWeekEntries = entries.filter(e => e.empIdx === i && e.date \u003c= endWk);\n            upToWeekEntries.forEach(e=>{\n                cumTotal += n(e.newA) + n(e.exA);\n                (e.accounts||[]).forEach(acc=>{\n                    if(acc && !seenAs.has(acc)){ seenAs.add(acc); allNewAccts.push(acc); }\n                });\n            });\n        } else {\n            let monthEntries = entries.filter(e => e.empIdx === i && e.date.slice(0, 7) === targetMonth);\n            monthEntries.forEach(e=>{\n                sumNew += n(e.newA);\n                sumEx += n(e.exA);\n            });\n\n            let upToMonthEntries = entries.filter(e => e.empIdx === i && e.date.slice(0, 7) \u003c= targetMonth);\n            upToMonthEntries.forEach(e=>{\n                cumTotal += n(e.newA) + n(e.exA);\n                (e.accounts||[]).forEach(acc=>{\n                    if(acc && !seenAs.has(acc)){ seenAs.add(acc); allNewAccts.push(acc); }\n                });\n            });\n        }\n        \n        let periodTotal = sumNew + sumEx;\n        let targetVal = x.target;\n        let achPct = targetVal ? (cumTotal / targetVal) * 100 : 0;\n        \n        gTarget += targetVal;\n        gNewCount += allNewAccts.length;\n        gPeriodNew += sumNew;\n        gPeriodEx += sumEx;\n        gPeriodTotal += periodTotal;\n        gCumulative += cumTotal;\n\n        let formattedAcctsHtml = allNewAccts.map(acc => {\n            if(isWeekly && currentPeriodNewAccts.has(acc)){\n                return `\u003cspan class=\"highlight-new\">${acc}\u003c/span>`;\n            } else if(isWeekly && pastPeriodAccts.has(acc)){\n                return compressAccountNumber(acc);\n            }\n            return acc;\n        }).join(', ');\n        \n        let periodNewHtml = (isWeekly && sumNew > 0) ? `\u003cspan class=\"highlight-new\">${fmt(sumNew)}\u003c/span>` : fmt(sumNew);\n\n        let tr=document.createElement('tr');\n        tr.innerHTML=`\n            \u003ctd class=\"center\">${x.code}\u003c/td>\n            \u003ctd>${x.branch}\u003c/td>\n            \u003ctd>${x.zone}\u003c/td>\n            \u003ctd class=\"sticky-id\">${x.employeeId}\u003c/td>\n            \u003ctd class=\"sticky-name\">${x.employee}\u003c/td>\n            \u003ctd>${x.designation}\u003c/td>\n            \u003ctd class=\"num\">${fmt(targetVal)}\u003c/td>\n            \u003ctd>${formattedAcctsHtml}\u003c/td>\n            \u003ctd class=\"center\">${allNewAccts.length}\u003c/td>\n            \u003ctd class=\"num\">${periodNewHtml}\u003c/td>\n            \u003ctd class=\"num\">${fmt(sumEx)}\u003c/td>\n            \u003ctd class=\"num\">${fmt(periodTotal)}\u003c/td>\n            \u003ctd class=\"num\">${fmt(cumTotal)}\u003c/td>\n            \u003ctd class=\"num ${achPct>=100?'good':'low'}\">${achPct.toFixed(2)}%\u003c/td>\n            \u003ctd>${x.remarks}\u003c/td>\n        `;\n        b.appendChild(tr);\n    });\n    \n    let gAchPct = gTarget ? (gCumulative / gTarget) * 100 : 0;\n    let ttr = document.createElement('tr');\n    ttr.innerHTML=`\n        \u003ctd colspan=\"3\" class=\"center\">GRAND TOTAL\u003c/td>\n        \u003ctd class=\"sticky-id\">-\u003c/td>\n        \u003ctd class=\"sticky-name\">\u003c/td>\n        \u003ctd>-\u003c/td>\n        \u003ctd class=\"num\">${fmt(gTarget)}\u003c/td>\n        \u003ctd>-\u003c/td>\n        \u003ctd class=\"center\">${gNewCount}\u003c/td>\n        \u003ctd class=\"num\">${fmt(gPeriodNew)}\u003c/td>\n        \u003ctd class=\"num\">${fmt(gPeriodEx)}\u003c/td>\n        \u003ctd class=\"num\">${fmt(gPeriodTotal)}\u003c/td>\n        \u003ctd class=\"num\">${fmt(gCumulative)}\u003c/td>\n        \u003ctd class=\"num ${gAchPct>=100?'good':'low'}\">${gAchPct.toFixed(2)}%\u003c/td>\n        \u003ctd>-\u003c/td>\n    `;\n    f.appendChild(ttr);\n}\n\nfunction downloadExcel(){\n    let table = document.getElementById('table');\n    let rows = table.querySelectorAll('tr');\n    if(rows.length \u003c= 1){ alert('No data available to download.'); return; }\n    \n    let csv = [];\n    rows.forEach(row => {\n        let cols = row.querySelectorAll('th, td');\n        let data = [];\n        cols.forEach(col => {\n            let text = col.innerText.replace(/\"/g, '\"\"');\n            data.push('\"' + text + '\"');\n        });\n        csv.push(data.join(','));\n    });\n    \n    let csvFile = new Blob(['\\uFEFF' + csv.join('\\n')], { type: 'text/csv;charset=utf-8;' });\n    let downloadLink = document.createElement('a');\n    let reportType = document.getElementById('reportType').value;\n    downloadLink.download = `${reportType}_deposit_mobilization_report.csv`;\n    downloadLink.href = window.URL.createObjectURL(csvFile);\n    downloadLink.style.display = 'none';\n    document.body.appendChild(downloadLink);\n    downloadLink.click();\n    document.body.removeChild(downloadLink);\n}\n\nMASTER.forEach((x,i)=>{\n    let o=document.createElement('option');\n    o.value=i;\n    o.textContent=x.employeeId+' - '+x.employee+' ('+x.designation+')';\n    document.getElementById('emp').appendChild(o);\n});\n\npopulateLogWeeks();\npopulateReportWeeks();\nrenderWeeklyLog();\nrenderAllLog();\ngenerateReport();\n\u003c/script>\u003c/body>\u003c/html>",
  visit: "\u003c!DOCTYPE html>\n\u003chtml lang=\"en\">\n\u003chead>\n    \u003cmeta charset=\"UTF-8\">\n    \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    \u003ctitle>Deposit Mobilization & Weekly Visit System\u003c/title>\n    \u003c!-- Tailwind CSS CDN -->\n    \u003cscript src=\"https://cdn.tailwindcss.com\">\u003c/script>\n\u003c/head>\n\u003cbody class=\"bg-slate-50 font-sans relative\">\n\n    \u003c!-- Toast Notification Container (Top Right Corner) -->\n    \u003cdiv id=\"toastContainer\" class=\"fixed top-5 right-5 z-50 flex flex-col gap-3\">\u003c/div>\n\n    \u003cdiv class=\"max-w-7xl mx-auto p-6 my-6 bg-white shadow-lg rounded-xl\">\n        \u003c!-- Top Headers -->\n        \u003cdiv class=\"text-center mb-6 border-b pb-4\">\n            \u003ch2 class=\"text-2xl font-bold text-sky-900\">Sammilito Islami Bank PLC\u003c/h2>\n            \u003ch4 class=\"text-lg font-semibold text-slate-700\">(First Security Islami Bank PLC)\u003c/h4>\n            \u003ch3 class=\"text-xl font-medium text-blue-800 mt-1\">Customer-wise Weekly Visit Report for Deposit Mobilization\u003c/h3>\n        \u003c/div>\n\n        \u003c!-- Main Navigation Tabs -->\n        \u003cdiv class=\"flex flex-wrap gap-2 mb-6 border-b pb-4\">\n            \u003cbutton onclick=\"switchMainTab('entry')\" id=\"btn-entry\" class=\"px-5 py-2.5 font-semibold rounded-lg bg-sky-900 text-white transition\">📝 Data Entry\u003c/button>\n            \u003cbutton onclick=\"switchMainTab('datastore')\" id=\"btn-datastore\" class=\"px-5 py-2.5 font-semibold rounded-lg bg-slate-200 text-slate-700 transition\">🗄️ Data Store\u003c/button>\n            \u003cbutton onclick=\"switchMainTab('reports')\" id=\"btn-reports\" class=\"px-5 py-2.5 font-semibold rounded-lg bg-slate-200 text-slate-700 transition\">📊 Weekly Reports\u003c/button>\n        \u003c/div>\n\n        \u003c!-- TAB 1: DATA ENTRY -->\n        \u003cdiv id=\"tab-entry\" class=\"tab-content\">\n            \u