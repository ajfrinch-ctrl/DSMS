ctInput);\n            }, 50);\n        } else {\n            tr.innerHTML = `\n                \u003ctd class=\"center\">${fmtDateStr(e.date)}\u003c/td>\n                \u003ctd class=\"center\">${x.employeeId}\u003c/td>\n                \u003ctd>${x.employee}\u003c/td>\n                \u003ctd>${x.designation}\u003c/td>\n                \u003ctd>${(e.accounts||[]).join(', ')}\u003c/td>\n                \u003ctd class=\"num\">${fmt(e.newA)}\u003c/td>\n                \u003ctd class=\"num\">${fmt(e.exA)}\u003c/td>\n                \u003ctd class=\"center\" style=\"white-space:nowrap;\">\n                    \u003cbutton class=\"edit-btn\" onclick=\"startInlineEdit('${e.id}')\">Edit\u003c/button>\n                    \u003cbutton class=\"del-btn\" onclick=\"deleteLogEntry('${e.id}')\">Delete\u003c/button>\n                \u003c/td>\n            `;\n        }\n        b.appendChild(tr);\n    });\n}\n\nfunction renderAllLog(){\n    let q = document.getElementById('logSearch').value.toLowerCase();\n    let b = document.getElementById('allLogBody');\n    b.innerHTML = '';\n    \n    let filtered = entries.filter(e=>{\n        let x = MASTER[e.empIdx];\n        let str = `${e.date} ${fmtDateStr(e.date)} ${x.employeeId} ${x.employee} ${x.designation}`.toLowerCase();\n        return !q || str.includes(q);\n    });\n    \n    filtered.sort((a,b)=>b.date.localeCompare(a.date));\n    \n    if(filtered.length === 0){\n        b.innerHTML = `\u003ctr>\u003ctd colspan=\"7\" class=\"center\" style=\"padding:20px;color:#777;\">No records found.\u003c/td>\u003c/tr>`;\n        return;\n    }\n    \n    filtered.forEach(e=>{\n        let x = MASTER[e.empIdx];\n        let tr = document.createElement('tr');\n        tr.innerHTML = `\n            \u003ctd class=\"center\">${fmtDateStr(e.date)}\u003c/td>\n            \u003ctd class=\"center\">${x.employeeId}\u003c/td>\n            \u003ctd>\u003cb>${x.employee}\u003c/b>\u003c/td>\n            \u003ctd>${x.designation}\u003c/td>\n            \u003ctd>${(e.accounts||[]).join(', ')}\u003c/td>\n            \u003ctd class=\"num\">${fmt(e.newA)}\u003c/td>\n            \u003ctd class=\"num\">${fmt(e.exA)}\u003c/td>\n        `;\n        b.appendChild(tr);\n    });\n}\n\nfunction populateReportWeeks(){\n    let weekSelect = document.getElementById('weekSelect');\n    let currentVal = weekSelect.value;\n    weekSelect.innerHTML = '';\n    \n    let weeksSet = new Set();\n    entries.forEach(e => weeksSet.add(wk(e.date)));\n    let todayWk = wk(iso(new Date()));\n    weeksSet.add(todayWk);\n    \n    let sortedWeeks = Array.from(weeksSet).sort().reverse();\n    \n    sortedWeeks.forEach(startStr => {\n        let startDate = new Date(startStr + 'T00:00:00');\n        let endDate = new Date(startDate);\n        endDate.setDate(endDate.getDate() + 6);\n        let endStr = iso(endDate);\n        \n        let opt = document.createElement('option');\n        opt.value = startStr;\n        opt.textContent = `Week: ${fmtDateStr(startStr)} to ${fmtDateStr(endStr)}`;\n        weekSelect.appendChild(opt);\n    });\n    \n    if(currentVal && weekSelect.querySelector(`option[value=\"${currentVal}\"]`)){\n        weekSelect.value = currentVal;\n    }\n}\n\nfunction toggleReportType(){\n    let reportType = document.getElementById('reportType').value;\n    if(reportType === 'weekly'){\n        document.getElementById('weekSelectLabel').style.display = 'block';\n        document.getElementById('monthSelectLabel').style.display = 'none';\n    } else {\n        document.getElementById('weekSelectLabel').style.display = 'none';\n        document.getElementById('monthSelectLabel').style.display = 'block';\n    }\n}\n\nfunction compressAccountNumber(acc){\n    let parts = acc.split('-');\n    if(parts.length > 1){\n        let prefix = parts[0];\n        let lastPart = parts[parts.length - 1];\n        if(parts.length > 2 || prefix.length > 4){\n            return prefix + '-' + lastPart;\n        }\n    }\n    return acc;