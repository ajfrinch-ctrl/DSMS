<title>FSIBL Tantar Branch Management Portal</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;height:100%;font-family:Arial,"Noto Sans Bengali",sans-serif;background:#f3f5f7}
.app{height:100vh;display:flex;overflow:hidden}
.sidebar{width:250px;flex:0 0 250px;background:#17324d;color:#fff;padding:18px 12px}
.brand{font-size:17px;font-weight:700;line-height:1.35;padding:5px 8px}
.branch{font-size:12px;color:#cbd8e5;padding:5px 8px 20px}
.nav{display:flex;flex-direction:column;gap:7px}
.nav button{border:0;background:transparent;color:#e8eef5;text-align:left;padding:12px;border-radius:7px;cursor:pointer;font-weight:700}
.nav button:hover,.nav button.active{background:#2c6798;color:#fff}
.main{min-width:0;flex:1;height:100%;display:flex;flex-direction:column}
.top{height:58px;flex:0 0 58px;background:#fff;border-bottom:1px solid #d9dee3;display:flex;align-items:center;justify-content:space-between;padding:0 18px}
.top h1{font-size:17px;margin:0;color:#17324d}
.top span{font-size:12px;color:#6b7280}
.content{flex:1;min-height:0;padding:10px}
.module{display:none;width:100%;height:100%}
.module.active{display:block}
.frame{width:100%;height:100%;border:0;border-radius:7px;background:#fff;box-shadow:0 1px 5px rgba(0,0,0,.12)}
.dashboard{height:100%;overflow:auto}
.hero,.card,.note{background:#fff;border-radius:9px;box-shadow:0 1px 5px rgba(0,0,0,.1)}
.hero{padding:22px;margin-bottom:15px}
.hero h2{margin:0 0 7px;color:#17324d}
.hero p{margin:0;color:#667085}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}
.card{padding:20px;cursor:pointer}
.card:hover{transform:translateY(-1px)}
.icon{font-size:28px}
.card h3{margin:8px 0 5px;color:#17324d}
.card p{margin:0;color:#667085;font-size:13px}
.note{margin-top:15px;padding:16px;color:#475467;font-size:13px;line-height:1.6}
@media(max-width:800px){.sidebar{width:190px;flex-basis:190px}.cards{grid-template-columns:1fr}}
@media(max-width:560px){
.sidebar{width:62px;flex-basis:62px;padding:12px 7px}
.brand{font-size:0;text-align:center}.brand:after{content:"FSIBL";font-size:16px}
.branch{display:none}.nav button{font-size:0;text-align:center;padding:12px 5px}
.nav button:before{font-size:20px}.nav button:nth-child(1):before{content:"⌂"}
.nav button:nth-child(2):before{content:"৳"}.nav button:nth-child(3):before{content:"♙"}.nav button:nth-child(4):before{content:"▣"}
.content{padding:6px}.top{padding:0 10px}.top span{display:none}
}
</style>
</head>
