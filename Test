Id = null;\n    alert('Entry updated successfully!');\n    renderWeeklyLog();\n}\n\nfunction deleteLogEntry(id){\n    if(!confirm('Are you sure you want to delete this entry from the weekly log?')) return;\n    entries = entries.filter(x=>x.id!==id);\n    persist();\n    renderWeeklyLog();\n}\n\nfunction populateLogWeeks(){\n    let logWeekSelect = document.getElementById('logWeekSelect');\n    let currentVal = logWeekSelect.value;\n    logWeekSelect.innerHTML = '';\n    \n    let weeksSet = new Set();\n    entries.forEach(e => weeksSet.add(wk(e.date)));\n    let todayWk = wk(iso(new Date()));\n    weeksSet.add(todayWk);\n    \n    let sortedWeeks = Array.from(weeksSet).sort().reverse();\n    \n    sortedWeeks.forEach(startStr => {\n        let startDate = new Date(startStr + 'T00:00:00');\n        let endDate = new Date(startDate);\n        endDate.setDate(endDate.getDate() + 6);\n        let endStr = iso(endDate);\n        \n        let opt = document.createElement('option');\n        opt.value = startStr;\n        opt.textContent = `${fmtDateStr(startStr)} to ${fmtDateStr(endStr)}`;\n        logWeekSelect.appendChild(opt);\n    });\n    \n    if(currentVal && logWeekSelect.querySelector(`option[value=\"${currentVal}\"]`)){\n        logWeekSelect.value = currentVal;\n    }\n}\n\nfunction renderWeeklyLog(){\n    let selectedWeekStart = document.getElementById('logWeekSelect').value || wk(iso(new Date()));\n    let startDateObj = new Date(selectedWeekStart + 'T00:00:00');\n    let endDateObj = new Date(startDateObj);\n    endDateObj.setDate(endDateObj.getDate() + 6);\n    let selectedWeekEnd = iso(endDateObj);\n    \n    document.getElementById('weeklyLogTitle').textContent = `Weekly Data Log (Range: ${fmtDateStr(selectedWeekStart)} to ${fmtDateStr(selectedWeekEnd)})`;\n    \n    let b = document.getElementById('weeklyLogBody');\n    b.innerHTML = '';\n    \n    let filtered = entries.filter(e => e.date >= selectedWeekStart && e.date \u003c= selectedWeekEnd);\n    f